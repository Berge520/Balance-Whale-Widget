# ── 依赖与构建产物 ──
node_modules
dist
dist-ssr
*.local
# eslint 加 --cache 时会在根目录落这个缓存（当前 lint 脚本未开）
.eslintcache
# vite / vue-tsc 的增量构建信息
*.tsbuildinfo

# ── 日志 ──
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# 插件运行日志：DEV 恒为 true，宿主会往 %TEMP%\whale-debug.log 落盘；
# 在仓库里复制一份取证的临时文件别提交
whale-debug*.log

# ── 凭据 / 环境变量 ──
# 密钥、Token、证书一律不进仓库（插件的 API Key / 平台 Token 存在 uTools
# dbCryptoStorage 里、本就不落仓库；这里防的是调试时顺手在仓库根放一份的明文密钥文件）
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# ── 插件运行时导出物 / 分发物 ──
# 设置页「备份与恢复」导出的 JSON：含挂件设置与账本，勾选「包含凭据」时还带加密的凭据块，
# 默认存到下载目录，手动另存到仓库里时不要提交
whale-backup-*.json
# uTools 打包产物（`.upx` 拖进 uTools 即可安装，属于分发物不是源码）
*.upx
# 本地手动打包的 Release 包：CI 的 zip 建在仓库外（.github/workflows/release.yml），
# 本地在仓库根 zip 出来的这份别提交
balance-whale-widget-*.zip
# 自定义素材：导入的形象 / 气泡图 / 音效正常落在 <userData>/whale-*/，
# 手动另存进仓库的这几类文件不要提交。
# 例外：public/whale-pack/ 下的内置包**随插件分发**（不是用户手动另存的素材），必须入库，
# 否则 CI 从零检出时读不到包体、单测与打包全挂。
*.whaleassets
!public/whale-pack/*.whaleassets

# ── 素材源（不进仓库）──
# 上游 QQ 群分享的原始素材（角色图 / 音频），文件名是中文原名。它是
# scripts/export-shared-assets.mjs 的输入、不是分发产物：入库会同时撑爆仓库
# 与放大版权风险。发布者本地保留一份即可 —— 真正的分发副本由导出脚本按 id 生成。
assets-src/

# ── 共享素材导出物（**入库**，供按需单张下载）──
# public/shared/ 由 scripts/export-shared-assets.mjs 生成：把 assets-src/ 的中文原名
# 按 id 重命名（Q1.png / AUGHHH.mp3，避开中文 URL 的兼容坑）后落这里。
# **必须入库**：用户按 URL 单张下载，源就是仓库里的这些文件（raw / jsDelivr 直接读仓库）。
# 但它**不能进插件包**（43MB 会白撑体积），由 vite.config.js 的 SKIP_PUBLIC_DIRS 排除。
# 这里显式放行：上方的 *.whaleassets 排除规则不涉及 png/mp3/ogg，写一条只为表意清晰。
!public/shared/**

# ── 打包中间产物（排除大件，保留缩略图）──
# skins-src/ 是 build-skin-pack.py 的输入（与 assets-src/ 同类的素材源，发布者本地保留即可）。
# thumbs/（36 张缩略图，约 404KB）要入库 —— 它随插件包分发，供设置页下载前预览。
resources/skins-src/
# manifest.json 是旧的整包打包脚本（已删）留下的核对用中间产物，运行时用不到，只本地留着核对
resources/manifest.json

# ── 临时 / 手动备份 ──
# 改 preload 前先存一份 `api.js.bak` 是常见习惯（preload 不热更、改完要在 uTools 里
# 重载插件才生效，改坏了好回退），这类文件容易忘了删就跟着提交
*.bak
*.orig
*.rej
# 「另存为 副本 / 副本 (2)」是 Windows 上最常见的误提交来源
*副本*
*的副本*
~$*
*.tmp

# ── 编辑器 / IDE ──
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# ── AI 助手工作区配置（项目规则 / 技能），不进仓库 ──
# 注意：换机器时这份要单独拷过去（内部含 utools-api 技能与项目规则）
.trae/
.cursor/
.claude/

# ── 操作系统垃圾 ──
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Linux
*~
