# ── 依赖与构建产物 ──
node_modules
dist
dist-ssr
*.local
# eslint 加 --cache 时会在根目录落这个缓存（当前 lint 脚本未开）
.eslintcache
# vite / vue-tsc 的增量构建信息
*.tsbuildinfo

# ── 日志 ──
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# 插件运行日志：DEV 恒为 true，宿主会往 %TEMP%\whale-debug.log 落盘；
# 在仓库里复制一份取证的临时文件别提交
whale-debug*.log

# ── 凭据 / 环境变量 ──
# 密钥、Token、证书一律不进仓库（插件的 API Key / 平台 Token 存在 uTools
# dbCryptoStorage 里、本就不落仓库；这里防的是调试时顺手在仓库根放一份的明文密钥文件）
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# ── 插件运行时导出物 / 分发物 ──
# 设置页「备份与恢复」导出的 JSON：含挂件设置与账本，勾选「包含凭据」时还带加密的凭据块，
# 默认存到下载目录，手动另存到仓库里时不要提交
whale-backup-*.json
# uTools 打包产物（`.upx` 拖进 uTools 即可安装，属于分发物不是源码）
*.upx
# 本地手动打包的 Release 包：CI 的 zip 建在仓库外（.github/workflows/release.yml），
# 本地在仓库根 zip 出来的这份别提交
balance-whale-widget-*.zip
# 自定义素材：导入的形象 / 气泡图 / 音效正常落在 <userData>/whale-*/，
# 手动另存进仓库的这几类文件不要提交
*.whaleassets

# ── 素材源（不进仓库）──
# 上游 QQ 群分享的原始素材（角色图 / 音频），是 build-assets-pack.py 的输入、
# 不是插件产物：**本体近 44MB，且来源为第三方分享**，入库会同时撑爆仓库与放大版权风险。
# 素材改为打包挂 Release 由用户按需下载（见 scripts/build-assets-pack.py）。
# 发布者本地保留一份即可；打包脚本产出（resources/ 下的 .whaleassets 与缩略图）另行提交。
assets-src/

# ── 素材包产物（保留缩略图，排除大件）──
# resources/ 由 build-assets-pack.py 生成：两个 .whaleassets 是发 Release 的远程附件本身，
# 随仓库入库等于把 43MB 二进制塞进 git 历史（而它们本就是「让用户去 Release 下」的东西）；
# manifest.json 是打包核对用的中间产物，运行时用不到。
# skins-src/ 是 build-skin-pack.py 的输入（与 assets-src/ 同类的素材源，发布者本地保留即可）。
# 只有 thumbs/（36 张缩略图，约 404KB）要入库 —— 它随插件包分发，供设置页下载前预览。
resources/*.whaleassets
resources/manifest.json
resources/skins-src/

# ── 临时 / 手动备份 ──
# 改 preload 前先存一份 `api.js.bak` 是常见习惯（preload 不热更、改完要在 uTools 里
# 重载插件才生效，改坏了好回退），这类文件容易忘了删就跟着提交
*.bak
*.orig
*.rej
# 「另存为 副本 / 副本 (2)」是 Windows 上最常见的误提交来源
*副本*
*的副本*
~$*
*.tmp

# ── 编辑器 / IDE ──
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# ── AI 助手工作区配置（项目规则 / 技能），不进仓库 ──
# 注意：换机器时这份要单独拷过去（内部含 utools-api 技能与项目规则）
.trae/
.cursor/
.claude/

# ── 操作系统垃圾 ──
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Linux
*~
